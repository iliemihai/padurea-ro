aliată din 2020 zona marcată avea copaci răzleți și bucăți de iarbă între ei, deci nu era o pădure deasă. În poza «după» apare un petic de pământ gol, rozaliu, în timp ce restul vegetației din jur rămâne verde, ceea ce arată o curățare a unui pășune cu copaci sau arbuști.","teren":"în afara amenajamentelor silvice publicate","parte_stat":0.0,"parte_privat":0.0,"parte_amenajament":0.0,"link":"https://iliemihai.github.io/padurea-ro/#a=20260608_46873_27714"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[27.5371,46.27785],[27.53554,46.27786],[27.53554,46.2775],[27.5345,46.27751],[27.53451,46.27823],[27.5371,46.27821],[27.5371,46.27785]]],[[[27.5371,46.27857],[27.54022,46.27856],[27.54022,46.2782],[27.53918,46.27821],[27.53917,46.27785],[27.53814,46.27785],[27.53814,46.27821],[27.5371,46.27821],[27.5371,46.27857]]]]},"properties":{"id":"20260608_46278_27537","judet":"Vaslui","uat":"comuna Coroiești","localitate":"Movileni","lat":46.27813,"lon":27.53722,"ha":2.4,"prima_data":"2026-06-08","poza_inainte":"2026-05-04","poza_dupa":"2026-06-30","stare":"acoperit","stare_text":"cu autorizație","motiv":"","apv":"2400145000680","ocol":"OCOLUL SILVIC BÂRLAD","apv_de_la":"2026-02-09","apv_pana_la":"2026-10-15","apv_distanta_m":0,"arie_protejata":"","analist_categorie":"","analist_incredere":"","ce_se_vede":"","teren":"pădure de stat","parte_stat":1.0,"parte_privat":0.0,"parte_amenajament":1.0,"link":"https://iliemihai.github.io/padurea-ro/#a=20260608_46278_27537"}},{"type":"Feature","geometry":{"type":"MultiPolygon","coordinates":[[[[28.20967,46.49987],[28.20915,46.49988],[28.20916,46.50024],[28.20968,46.50023],[28.20967,46.49987]]],[[[28.20863,46.50024],[28.20865,46.50096],[28.20917,46.50096],[28.20916,46.50024],[28.20863,46.50024]]],[[[28.20866,46.50132],[28.20865,46.50096],[28.20813,46.50097],[28.20814,46.50133],[28.20866,46.50132]]],[[[28.20814,46.50133],[28.20762,46.50133],[28.20764,46.50241],[28.20816,46.50241],[28.20814,46.50133]]],[[[28.20713,46.502